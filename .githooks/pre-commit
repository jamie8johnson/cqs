#!/bin/sh
# Pre-commit hook: private-term scan, cargo fmt check, Cargo.lock sync,
# env-var docs sync.

# private-scan --staged (xtask/). Its own build folder keeps it from waiting
# on a build of the main crate. Exit 1 stops the commit; exit 2 (not
# checked) and a scan that could not run print a line and let it go on.
top="$(git rev-parse --show-toplevel)"
scan_out="$(cargo run --quiet --manifest-path "$top/xtask/Cargo.toml" \
    --target-dir "$top/xtask/target" --locked -- private-scan --staged 2>/dev/null)"
case $? in
    0|2)
        printf '%s\n' "$scan_out"
        ;;
    1)
        printf '%s\n' "$scan_out"
        echo "Commit stopped: private-scan found a private term in the staged change."
        exit 1
        ;;
    *)
        echo "private-scan: not checked: could not run"
        ;;
esac

echo "Running cargo fmt --check..."
cargo fmt --check
if [ $? -ne 0 ]; then
    echo ""
    echo "Error: Code is not formatted. Run 'cargo fmt' to fix."
    exit 1
fi
echo "Format check passed."

# Check if Cargo.lock needs updating (only if a manifest of the root
# workspace is staged; xtask/ keeps its own lock file).
if git diff --cached --name-only | grep -qE '^(cqs-macros/)?Cargo\.toml$'; then
    echo "Checking Cargo.lock sync..."
    cargo check --quiet 2>/dev/null
    if git diff --name-only | grep -qE '^Cargo\.lock$'; then
        echo ""
        echo "Warning: Cargo.lock changed after cargo check."
        echo "Consider staging Cargo.lock: git add Cargo.lock"
    fi
fi

# env_var_docs sync — fast, ~1s. Runs only when staged changes touch
# either Rust source under src/ (where new CQS_* env vars get
# introduced) or README.md (where the env-var table lives). The
# substring-match-vs-token-match fix is pinned by 8 sibling tests
# inside the same test binary; any regression of the matcher itself
# fails CI loudly. The output is held in a variable so the test's own
# exit status decides (a pipe into tail would report tail's).
staged="$(git diff --cached --name-only)"
if echo "$staged" | grep -qE '^src/.*\.rs$|^README\.md$|^tests/env_var_docs\.rs$'; then
    echo "Running cargo test --test env_var_docs..."
    if ! docs_out="$(cargo test --test env_var_docs --features gpu-index --quiet 2>&1)"; then
        printf '%s\n' "$docs_out" | tail -20
        echo ""
        echo "Error: env_var_docs test failed. Either:"
        echo "  - add the missing CQS_* var to the env-var table in README.md, or"
        echo "  - if it's a test-only fixture, name it CQS_TEST_* (allowlisted)."
        exit 1
    fi
    echo "env_var_docs check passed."
fi
